<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SRtoolbox</RootNamespace>
    <AssemblyName>SRtoolbox</AssemblyName>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>SRtoolbox.Program</StartupObject>
	<Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Pfim">
      <HintPath>lib\Pfim.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="res\icon.ico" />
    <Content Include="res\toolbox-red.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LSRutil.NET" Version="1.4.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Core" Version="1.1.5" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>
</Project>